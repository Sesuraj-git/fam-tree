DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
JWT_SECRET=replace-with-a-long-random-hex-string

# Public URL used to build links in emails (claim invite, password reset).
APP_URL=http://localhost:3000

# Zoho Mail SMTP — use smtp.zoho.eu / smtp.zoho.in if your account is on
# those regions. SMTP_PASS is a Zoho "Application-Specific Password", not
# your account login password (required if 2FA is on; recommended either way).
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=you@yourdomain.com
SMTP_PASS=replace-with-a-zoho-app-specific-password
SMTP_FROM=you@yourdomain.com
